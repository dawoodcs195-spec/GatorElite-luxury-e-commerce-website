# ─── Required Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in the values

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/gatorelite

# JWT secret for authentication tokens (generate a strong random string)
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here

# Session secret for legacy auth middleware
SESSION_SECRET=your-session-secret-here

# Admin and viewer passwords for legacy auth
ADMIN_PASSWORD=your-admin-password-here
VIEWER_PASSWORD=your-viewer-password-here

# ─── Rate Limiting Configuration ────────────────────────────────────────────
# All thresholds are configurable. Adjust these values to match your needs.

# Auth routes (login, register, password reset) - Strict limits
RATE_LIMIT_AUTH_WINDOW_MS=900000          # 15 minutes window
RATE_LIMIT_AUTH_MAX_IP=5                  # Max 5 requests per IP per window
RATE_LIMIT_AUTH_MAX_ACCOUNT=3             # Max 3 requests per account per window

# Public routes (products, search) - Moderate limits  
RATE_LIMIT_PUBLIC_WINDOW_MS=60000         # 1 minute window
RATE_LIMIT_PUBLIC_MAX=60                  # Max 60 requests per IP per window

# Authenticated routes (profile, cart) - Looser limits
RATE_LIMIT_AUTHENTICATED_WINDOW_MS=60000  # 1 minute window
RATE_LIMIT_AUTHENTICATED_MAX=120          # Max 120 requests per IP per window

# Exponential Backoff Configuration
RATE_LIMIT_BACKOFF_BASE_MS=60000          # Base backoff: 1 minute
RATE_LIMIT_BACKOFF_MAX_MS=3600000         # Max backoff: 1 hour

# ─── Email (Contact Form Notifications) ─────────────────────────────────────
# SMTP credentials for sending contact form email notifications
# For Gmail: use an App Password (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where contact form notifications are sent (defaults to SMTP_USER)
CONTACT_EMAIL=concierge@gatorelite.com

# Where order notifications are sent (defaults to SMTP_USER)
ORDER_EMAIL=dawood.cs195@gmail.com

# ─── Site URL ───────────────────────────────────────────────────────────────
# Public site URL for password reset links and email templates
NEXT_PUBLIC_SITE_URL=http://localhost:3000
